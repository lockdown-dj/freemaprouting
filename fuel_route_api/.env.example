# Copy this file to .env and adjust as needed.

DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Vehicle assumptions (assignment defaults)
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10

# Corridor: how far (miles) off the driving route a fuel station may be
# to still be considered "along the route".
ROUTE_CORRIDOR_MILES=12

# Nominatim (geocoding) - free, keyless, but requires a descriptive User-Agent
# and a max of 1 request/second per its usage policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-api-local-dev (contact: fuel-route-api-dev@localhost)

NOMINATIM_MIN_INTERVAL_SECONDS=1.0

# OSRM (routing) - free, keyless public demo server.
# For production use, self-host OSRM or use a provider with an SLA.
OSRM_BASE_URL=https://router.project-osrm.org

# How long to cache geocoding / route / plan results, in seconds.
GEOCODE_CACHE_TTL=2592000
ROUTE_CACHE_TTL=86400
PLAN_CACHE_TTL=86400